{
  "name": "dungeon-draft-converter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" && vitest run",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "NODE_ENV=production node src/server.ts",
    "dev": "node --watch-path=src src/server.ts",
    "build": "vite build",
    "bench": "node scripts/bench.ts",
    "gallery": "node scripts/build-gallery.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "motion": "^14.9.0",
    "multer": "^2.5.0",
    "react-router": "^8.5.1",
    "sharp": "^0.35.5"
  }
}
