{
  "name": "dungeon-draft-converter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "DOTENV_CONFIG_PATH=.env.testing tsx --import dotenv/config --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" && vitest run",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "NODE_ENV=production node src/server.ts",
    "dev": "node --import dotenv/config --watch-path=src src/server.ts",
    "build": "vite build && node scripts/precompress.ts",
    "bench": "node scripts/bench.ts",
    "db": "docker compose -f compose.yml -f compose.dev.yml up -d --wait postgres postgres-test",
    "db:migrate": "node --import dotenv/config src/db/migrate.ts",
    "gallery:sync": "node --import dotenv/config src/gallery/sync-now.ts"
  },
  "devDependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.8",
    "jsdom": "^29.1.1",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "motion": "^14.9.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react-router": "^8.5.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}
